+/// Execute a phase3-compiled kernel over entire arrays element-by-element.
+/// Takes a kernel_id, a list of input arrays (as raw pointer + length pairs),
+/// and an output buffer pointer. For each element index i, extracts the i-th
+/// f64 from each input array, executes the kernel, and writes the result to output[i].
+///
+/// This is the key bridge that allows the Python JIT to execute compiled
+/// native code over arrays without falling back to interpret_trace.
+#[pyfunction]
+#[pyo3(signature = (kernel_id, input_ptrs, input_lengths, output_ptr, output_length))]
+fn phase3_execute_array(
+    kernel_id: usize,
+    input_ptrs: Vec<usize>,
+    input_lengths: Vec<usize>,
+    output_ptr: usize,
+    output_length: usize,
+) -> PyResult<usize> {
+    let kernels = P3_KERNELS.lock().map_err(|e| {
+        pyo3::exceptions::PyRuntimeError::new_err(e.to_string())
+    })?;
+    let native = kernels.get(kernel_id)
+        .and_then(|k| k.as_ref())
+        .ok_or_else(|| {
+            pyo3::exceptions::PyValueError::new_err(
+                format!("Invalid kernel_id: {}", kernel_id)
+            )
+        })?;
+
+    // Verify all input arrays have the same length as output
+    let n = output_length;
+    for (i, &len) in input_lengths.iter().enumerate() {
+        if len != n {
+            return Err(pyo3::exceptions::PyValueError::new_err(
+                format!("Input array {} has length {} but output has length {}", i, len, n)
+            ));
+        }
+    }
+
+    unsafe {
+        let output = std::slice::from_raw_parts_mut(output_ptr as *mut f64, n);
+        let input_slices: Vec<&[f64]> = input_ptrs.iter().zip(input_lengths.iter())
+            .map(|(&ptr, &len)| std::slice::from_raw_parts(ptr as *const f64, len))
+            .collect();
+
+        for i in 0..n {
+            let values: Vec<Value> = input_slices.iter()
+                .map(|slice| Value::F64(slice[i]))
+                .collect();
+
+            match p3::execute(native, &values) {
+                Ok(Value::F64(v)) => { output[i] = v; }
+                Ok(Value::I64(v)) => { output[i] = v as f64; }
+                Ok(Value::I32(v)) => { output[i] = v as f64; }
+                _ => { output[i] = 0.0; }
+            }
+        }
+    }
+
+    Ok(n)
+}
+
