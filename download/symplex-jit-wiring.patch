+    def _compile_native(self):
+        """Compile the trace to native code via phase3 JIT.
+
+        Serializes the trace and calls phase3_compile from the Rust backend.
+        Stores the kernel_id for subsequent native execution.
+        Only compiles traces that use ops supported by the Rust engine.
+        """
+        if self._trace is None:
+            return
+
+        # Check if trace contains ops not supported by the Rust engine
+        # (pow, tanh, sigmoid, reduce_add, reduce_max, reduce_min, matmul)
+        unsupported_ops = {"pow", "tanh", "sigmoid", "reduce_add", "reduce_max", "reduce_min", "matmul"}
+        for instr in self._trace:
+            if instr[0] == "binop" and instr[2] in unsupported_ops:
+                return  # Can't compile natively — has unsupported ops
+            if instr[0] == "unop" and instr[2] in unsupported_ops:
+                return  # Can't compile natively — has unsupported ops
+
+        try:
+            from ._symplex_core import phase3_compile, serialize_instructions
+        except ImportError:
+            return  # Rust backend not available
+
+        try:
+            # Count parameters (arguments) from the allocator
+            param_count = 0
+            for slot, tv in self._allocator._slots.items():
+                if tv.name.startswith("arg"):
+                    try:
+                        idx = int(tv.name[3:])
+                        param_count = max(param_count, idx + 1)
+                    except ValueError:
+                        pass
+
+            # Serialize the trace
+            trace_bytes = serialize_instructions(self._trace)
+
+            # Compile via phase3 JIT
+            result = phase3_compile(trace_bytes, param_count)
+            if result.get("success", False):
+                self._native_kernel_id = result["kernel_id"]
+        except Exception:
+            # Compilation failed — leave kernel_id as None, will fall back
+            self._native_kernel_id = None
+
+    def _execute_native(self, inputs):
+        """Execute the compiled native kernel on the given inputs.
+
+        For scalar arguments: calls phase3_execute_f64 directly.
+        For array arguments: iterates element-by-element, calling
+        phase3_execute_f64 for each set of scalar values, writing
+        results into an output array.
+
+        Returns a DeviceArray on success, or None on failure.
+        """
+        if self._native_kernel_id is None:
+            return None
+
+        try:
+            from ._symplex_core import phase3_execute_f64, phase3_execute_array
+        except ImportError:
+            try:
+                from ._symplex_core import phase3_execute_f64
+                phase3_execute_array = None
+            except ImportError:
+                return None
+
+        kernel_id = self._native_kernel_id
+
+        # Build arg-slot mapping to know parameter order
+        arg_slot_map = {}
+        for slot, tv in self._allocator._slots.items():
+            if tv.name.startswith("arg"):
+                try:
+                    arg_slot_map[int(tv.name[3:])] = slot
+                except ValueError:
+                    pass
+
+        # Unwrap inputs to raw ndarrays
+        raw_inputs = []
+        for inp in inputs:
+            if isinstance(inp, DeviceArray):
+                raw_inputs.append(inp._data)
+            elif isinstance(inp, np.ndarray):
+                raw_inputs.append(inp)
+            else:
+                raw_inputs.append(np.asarray(inp, dtype=np.float64))
+
+        # Determine if all inputs are scalars
+        all_scalar = all(inp.ndim == 0 for inp in raw_inputs)
+
+        if all_scalar:
+            # Scalar path: execute directly
+            args_list = []
+            for i in range(len(raw_inputs)):
+                s = arg_slot_map.get(i)
+                if s is not None:
+                    args_list.append(float(raw_inputs[i]))
+            try:
+                result_val = phase3_execute_f64(kernel_id, args_list)
+                return result_val
+            except Exception:
+                self._native_kernel_id = None
+                return None
+
+        # Array path: try phase3_execute_array for efficiency
+        if phase3_execute_array is not None:
+            try:
+                # Collect contiguous float64 arrays
+                f64_inputs = []
+                for inp in raw_inputs:
+                    if inp.dtype != np.float64:
+                        inp = np.ascontiguousarray(inp, dtype=np.float64)
+                    else:
+                        inp = np.ascontiguousarray(inp)
+                    f64_inputs.append(inp)
+
+                # Determine output length (use first array's size)
+                n = f64_inputs[0].size
+                output = np.empty(n, dtype=np.float64)
+
+                # Extract raw pointers and lengths
+                input_ptrs = [arr.ctypes.data for arr in f64_inputs]
+                input_lengths = [n] * len(f64_inputs)
+                output_ptr = output.ctypes.data
+
+                count = phase3_execute_array(
+                    kernel_id, input_ptrs, input_lengths, output_ptr, n
+                )
+                if count == n:
+                    # Reshape output to match the trace result shape
+                    # For now, return flat array wrapped in DeviceArray
+                    return DeviceArray._wrap(output)
+            except Exception:
+                pass  # Fall through to element-by-element
+
+        # Element-by-element fallback using phase3_execute_f64
+        try:
+            # Determine the number of elements
+            n = raw_inputs[0].size if len(raw_inputs) > 0 else 1
+            output = np.empty(n, dtype=np.float64)
+
+            # Flatten inputs for iteration
+            flat_inputs = [inp.ravel() for inp in raw_inputs]
+
+            for i in range(n):
+                args_list = []
+                for j in range(len(flat_inputs)):
+                    args_list.append(float(flat_inputs[j][i]))
+                result_val = phase3_execute_f64(kernel_id, args_list)
+                output[i] = result_val
+
+            return DeviceArray._wrap(output)
+        except Exception:
+            # Native execution failed — invalidate kernel and return None
+            self._native_kernel_id = None
+            return None
 
     def __call__(self, *args):
         """Execute the JIT-compiled function (optimized hot path)."""
@@ -935,7 +1104,13 @@ class JitFunction:
         if self._fast_path is not None:
             return self._fast_path(inputs)
 
-        # ── Full interpreter path ──
+        # ── Try native JIT execution ──
+        if self._native_kernel_id is not None:
+            result = self._execute_native(inputs)
+            if result is not None:
+                return result
+
+        # ── Final fallback: interpret_trace ──
         result = interpret_trace(self._trace, inputs, self._allocator)
         return result
 
