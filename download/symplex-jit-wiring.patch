+        """GELU — traced as the full approximate expression.
+
+        gelu(x) ≈ 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
+
+        Emitted as a sequence of primitive ops:
+          1. x^3 = x * x * x
+          2. 0.044715 * x^3
+          3. x + 0.044715 * x^3
+          4. sqrt(2/pi) * (x + 0.044715 * x^3)   [sqrt(2/pi) ≈ 0.7978]
+          5. tanh(...)  — custom unop
+          6. 1 + tanh(...)
+          7. x * (1 + tanh(...))
+          8. 0.5 * x * (1 + tanh(...))
+        """
+        # Step 1: x^3 = x * x * x
+        x_sq = self._emit_binop("mul", self)       # x * x
+        x_cubed = self._emit_binop("mul", x_sq)    # x^2 * x = x^3
+
+        # Step 2: 0.044715 * x^3
+        c044715 = _const(self.allocator, self.trace, 0.044715, self.dtype)
+        term2 = x_cubed._emit_binop("mul", c044715)  # 0.044715 * x^3
+
+        # Step 3: x + 0.044715 * x^3
+        inner = self._emit_binop("add", term2)       # x + 0.044715*x^3
+
+        # Step 4: sqrt(2/pi) * inner  [sqrt(2/pi) ≈ 0.7978540]
+        c7978 = _const(self.allocator, self.trace, 0.7978540, self.dtype)
+        scaled = inner._emit_binop("mul", c7978)     # 0.7978 * (x + 0.044715*x^3)
+
+        # Step 5: tanh(scaled) — custom unop
+        t = scaled._emit_unop("tanh")
+
+        # Step 6: 1 + tanh(...)
+        one = _const(self.allocator, self.trace, 1.0, self.dtype)
+        one_plus_t = one._emit_binop("add", t)       # 1 + tanh(...)
+
+        # Step 7: x * (1 + tanh(...))
+        x_times = self._emit_binop("mul", one_plus_t) # x * (1 + tanh(...))
+
+        # Step 8: 0.5 * x * (1 + tanh(...))
+        half = _const(self.allocator, self.trace, 0.5, self.dtype)
+        result = half._emit_binop("mul", x_times)     # 0.5 * x * (1 + tanh(...))
+
+        return result
 
