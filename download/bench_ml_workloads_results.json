  "critical_bugs_found": {
    "1_evex_encoding": "JIT-compiled AVX-512 kernels crash with SIGILL. The emit_avx512_binop P2 byte is hardcoded wrong: z=1(zeroing), b=1(rounding), aaa=100(k4 mask), V'=0(wrong). Correct P2 should be z=0,L'=1,L=0,b=0,V'=~(src1>>4),aaa=000",
    "2_matmul_512_correctness": "512x512 parallel_matmul fails correctness check (max error ~1e-4)",
    "3_vzeroall_in_epilogue": "emit_epilogue always emits vzeroall, even for SSE2-only paths, wasting cycles",
    "4_jit_compile_same_code_size": "All matmul JIT kernels produce 289 bytes regardless of size, suggesting the codegen is not actually generating the correct loop structure",
    "5_duplicate_definitions": "__init__.py has TWO DeviceArray classes and TWO jit() functions - the ctypes-based ones at the bottom override the proper ones"
  },
  "summary": {
    "wins_vs_numpy": 0,
    "losses_vs_numpy": 10,
    "ties_vs_numpy": 0,
    "win_rate_pct": 0,
    "best_result": "1x768x2304 GEMM (single-token inference) at 1.16x speedup",
    "worst_result": "128x768x3072 FFN up-projection at 0.02x (50x slower)",
    "root_causes": [
      "1. NumPy BLAS is decades-optimized with cache-blocking, register tiling, and microkernels",
      "2. SympleX FFI overhead (Python→Rust ctypes call) dominates for small/medium matrices",
      "3. JIT-compiled kernels are completely broken (EVEX encoding bugs)",
      "4. The parallel_matmul Rust kernel has correctness issues at 512x512+",
      "5. No cache tiling in the Python-side matmul path - every call allocates a new C array"
    ]
  }
